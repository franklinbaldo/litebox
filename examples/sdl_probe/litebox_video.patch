+    frame_pkt[0] = (uint8_t)(LB_BODY_LEN & 0xFF);
+    frame_pkt[1] = (uint8_t)((LB_BODY_LEN >> 8) & 0xFF);
+    frame_pkt[2] = (uint8_t)((LB_BODY_LEN >> 16) & 0xFF);
+    frame_pkt[3] = (uint8_t)((LB_BODY_LEN >> 24) & 0xFF);
+
+    frame_pkt[4] = 'F';
+    frame_pkt[5] = 'R';
+    frame_pkt[6] = 'A';
+    frame_pkt[7] = 'M';
+
+    frame_pkt[8] = (uint8_t)(LB_EXPECTED_WIDTH & 0xFF);
