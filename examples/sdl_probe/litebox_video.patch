+    negotiated_max = (LB_HS_MAX_MESSAGE < host_max_message) ? LB_HS_MAX_MESSAGE : host_max_message;
+    if (negotiated_max < LB_BODY_LEN) {
+        return SDL_SetError("LiteBox video: negotiated max_message %u too small for frame body %u",
+                            (unsigned int)negotiated_max, (unsigned int)LB_BODY_LEN);
+    }
+
+    return 0;
+}
