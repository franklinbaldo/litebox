+    host_max_message = (uint32_t)host_hs[6]
+                     | ((uint32_t)host_hs[7] << 8)
+                     | ((uint32_t)host_hs[8] << 16)
+                     | ((uint32_t)host_hs[9] << 24);
+    if (host_max_message == 0) {
+        return SDL_SetError("LiteBox video: host max_message is 0");
+    }
