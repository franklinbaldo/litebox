+static int lb_write_exact(int fd, const void *buf, size_t count)
+{
+    const uint8_t *p = (const uint8_t *)buf;
+    size_t left = count;
+    while (left > 0) {
+        ssize_t n = write(fd, p, left);
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return -1;
+        }
+        if (n == 0) {
+            return -1;
+        }
+        p += n;
+        left -= (size_t)n;
+    }
+    return 0;
+}
+
+static int lb_read_exact(int fd, void *buf, size_t count)
+{
+    uint8_t *p = (uint8_t *)buf;
+    size_t left = count;
+    while (left > 0) {
+        ssize_t n = read(fd, p, left);
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return -1;
+        }
+        if (n == 0) {
+            return -1;
+        }
+        p += n;
+        left -= (size_t)n;
+    }
+    return 0;
+}
+
+static int lb_perform_handshake(void)
+{
+    uint8_t guest_hs[12];
+    uint8_t host_hs[12];
+    uint16_t host_version;
+    uint32_t host_max_message;
+    uint32_t negotiated_max;
+
+    /* Guest handshake (12 bytes):
+     * [0..3]:   "LBDF" (ASCII)
+     * [4..5]:   u16LE version (1)
+     * [6..9]:   u32LE max_message (1048576)
+     * [10..11]: u16LE flags (0)
+     */
+    guest_hs[0] = 'L';
+    guest_hs[1] = 'B';
+    guest_hs[2] = 'D';
+    guest_hs[3] = 'F';
+    guest_hs[4] = (uint8_t)(LB_HS_VERSION & 0xFF);
+    guest_hs[5] = (uint8_t)((LB_HS_VERSION >> 8) & 0xFF);
+    guest_hs[6] = (uint8_t)(LB_HS_MAX_MESSAGE & 0xFF);
+    guest_hs[7] = (uint8_t)((LB_HS_MAX_MESSAGE >> 8) & 0xFF);
+    guest_hs[8] = (uint8_t)((LB_HS_MAX_MESSAGE >> 16) & 0xFF);
+    guest_hs[9] = (uint8_t)((LB_HS_MAX_MESSAGE >> 24) & 0xFF);
+    guest_hs[10] = (uint8_t)(LB_HS_FLAGS & 0xFF);
+    guest_hs[11] = (uint8_t)((LB_HS_FLAGS >> 8) & 0xFF);
+
+    if (lb_write_exact(4, guest_hs, sizeof(guest_hs)) < 0) {
+        return SDL_SetError("LiteBox video: failed to write 12-byte handshake to FD 4");
+    }
+
+    if (lb_read_exact(3, host_hs, sizeof(host_hs)) < 0) {
+        return SDL_SetError("LiteBox video: failed to read 12-byte handshake from FD 3");
+    }
+
+    if (host_hs[0] != 'L' || host_hs[1] != 'B' || host_hs[2] != 'D' || host_hs[3] != 'F') {
+        return SDL_SetError("LiteBox video: invalid host handshake magic");
+    }
+
+    host_version = (uint16_t)host_hs[4] | ((uint16_t)host_hs[5] << 8);
+    if (host_version != LB_HS_VERSION) {
+        return SDL_SetError("LiteBox video: unsupported host version %u", (unsigned int)host_version);
+    }
